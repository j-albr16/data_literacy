   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "plt.style.use(\"ggplot\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "031c5a46",
   "metadata": {},
   "outputs": [],
   "source": [
    "N = 100\n",
    "nums_1 = np.random.randn(N)\n",
    "nums_2 = np.random.randn(N)\n",
    "nums_1[:4]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6c0195e7",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.scatter(range(N), nums_1, marker=\"*\")\n",
    "plt.scatter(range(N), nums_2, marker=\"+\")\n",
    "plt.show()"
   ]
  },
